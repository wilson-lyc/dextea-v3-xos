# 环境变量示例：复制为 .env 并按需修改。
# 程序启动时会自动加载工作目录下的 .env（不覆盖已存在的环境变量）；
# 部署环境也可不走 .env，直接由 systemd / docker-compose env_file / K8s env 注入。

# 配置文件路径（默认 configs/config.yaml）
CONFIG_PATH=configs/config.yaml

# 对象存储密钥（configs/config.yaml 中 ${OSS_ACCESS_KEY} 占位符引用）
OSS_ACCESS_KEY=
OSS_SECRET_KEY=

# ==== OpenTelemetry 链路追踪 ====
# OTLP/HTTP 导出端点（SDK 默认端口 4318）。不配置时 span 不会被导出。
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# 附加请求头，如鉴权：authorization=Bearer xxx（可选，多个用逗号分隔）
# OTEL_EXPORTER_OTLP_HEADERS=
# 导出超时时间（毫秒），默认 10000
# OTEL_EXPORTER_OTLP_TIMEOUT=10000
# 追加资源属性，如部署环境（service.name 由 configs/config.yaml 的 telemetry.service-name 提供）
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod
# 采样策略：父级决定，无则全采样（1.0）；生产可按需调低，如 0.1 采 10%
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
